{
  "3m-average": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "readings": {
          "reads": [
            "outdoor.temperature"
          ]
        },
        "period": {
          "means": "3m"
        },
        "average": true
      }
    },
    "note": "an average over a period is summary's `average`; 3m is the last 3 months, passed as said"
  },
  "3m-wind-chart": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "readings": {
          "reads": [
            "wind.wind_direction"
          ]
        },
        "period": {
          "means": "3m"
        },
        "chart": {
          "one_of": [
            true,
            null
          ]
        }
      }
    },
    "note": "a chart over time is summary's; wind direction draws the compass rose"
  },
  "temperature-and-rain": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": [
        {
          "readings": {
            "reads": [
              "outdoor.temperature",
              "rainfall.rain"
            ]
          },
          "chart": true
        },
        {
          "chart_readings": {
            "reads": [
              "outdoor.temperature",
              "rainfall.rain"
            ]
          },
          "chart": true
        }
      ]
    },
    "note": "both readings drawn, a panel each (the bot once drew only temperature); no period: a chart's default, the last 24 hours"
  },
  "humidity-chart": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "readings": {
          "reads": [
            "outdoor.humidity"
          ],
          "not": [
            "outdoor.temperature"
          ]
        }
      }
    },
    "note": "the lowest and highest of a period are summary's; only humidity (the bot once charted temperature)"
  },
  "pressure-rain-correlation": {
    "tools": [
      "relate"
    ],
    "not_tools": [
      "days"
    ],
    "args": {
      "relate": {
        "reading": {
          "reads": [
            "pressure.relative"
          ],
          "optional": true
        }
      }
    },
    "note": "\"X against rain\" is relate (pressure is its default), not monthly extremes"
  },
  "pressure-vs-rain-graph": {
    "tools": [
      "relate"
    ],
    "args": {
      "relate": {
        "reading": {
          "reads": [
            "pressure.relative"
          ],
          "optional": true
        },
        "chart": true
      }
    },
    "note": "a chart of a reading against rain is relate's, with chart"
  },
  "public-holidays": {
    "tools": [
      "days"
    ],
    "args": {
      "days": {
        "only": "public_holiday",
        "sort_by": {
          "one_of": [
            "temp_max",
            null
          ]
        }
      }
    },
    "note": "days filtered to public holidays and ranked; no period: every day on record"
  },
  "hottest-day-that-rained": {
    "tools": [
      "days"
    ],
    "args": {
      "days": {
        "sort_by": "temp_max",
        "order": {
          "one_of": [
            "desc",
            null
          ]
        },
        "where": {
          "conditions": [
            {
              "field": "rain",
              "op": [
                ">=",
                ">"
              ]
            }
          ]
        }
      }
    },
    "note": "a condition on one figure and a ranking on another is days (a rainy day is rain >= 1)"
  },
  "wind-direction-week": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "readings": {
          "reads": [
            "wind.wind_direction"
          ]
        },
        "period": {
          "means": "this week"
        }
      }
    },
    "note": "the most common direction of a period is summary's wind direction"
  },
  "will-it-rain": {
    "tools": [
      "outlook"
    ],
    "note": "will it rain in the next few hours is outlook"
  },
  "air-now": {
    "tools": [
      "current"
    ],
    "args": {
      "current": {
        "readings": {
          "reads": [
            "air.pm2_5"
          ],
          "optional": true
        }
      }
    },
    "note": "the air now is current; with no readings named it gives everything, the air included"
  },
  "weather-week": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "period": {
          "means": "this week"
        },
        "chart": {
          "one_of": [
            true,
            null
          ]
        },
        "readings": {
          "reads": [
            "outdoor.temperature"
          ],
          "optional": true
        }
      }
    },
    "note": "a bare reading and a period is a chart over the period; \"weather\" is every station reading"
  },
