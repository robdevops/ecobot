  },
  "a-day-in-2023": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": {
        "readings": {
          "reads": [
            "outdoor.temperature"
          ]
        },
        "start": {
          "regex": "^2023-11-10 11:00",
          "e.g.": "2023-11-10 11:00"
        },
        "end": {
          "regex": "^2023-11-11 11:00",
          "e.g.": "2023-11-11 11:00"
        }
      }
    },
    "note": "a window with times is start and end, never a period"
  },
