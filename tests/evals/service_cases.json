        "context": {
          "one_of": [
            true,
            null
          ]
        }
      }
    },
    "note": "the bot's gauges (drawn in code) are the bot's; a plain client shows current, with context the gauges' highs and lows"
  },
  "weather-report-for-a-day": {
    "any_tools": [
      "summary",
      "days",
      "forecast"
    ],
    "args": {
      "summary": {
        "period": {
          "means": [
            "Tuesday",
            "today"
          ]
        }
      },
      "days": {
        "period": {
          "means": "Tuesday"
        }
      },
      "forecast": {
        "period": {
          "regex": "(?i)tuesday|today",
          "e.g.": "Tuesday"
        }
      }
    },
    "note": "asked on a Tuesday: last Tuesday's figures, or today's report (current, forecast \"today\", pollen: the report as the tool descriptions give it, so pollen is no longer refused). The bot's case kept its own fast path (wants_report) from taking it as the bare report; a plain client has no fast path, and Tuesday is today"
  },
  "air-quality-vs-rain": {
    "tools": [
      "relate"
    ],
    "args": {
      "relate": {
        "reading": {
          "reads_any": [
            "air.pm2_5",
            "air.pm10"
          ]
        }
      }
    },
    "note": "is the air cleaner after rain: relate with PM2.5 or PM10, both devices together"
  },
  "rating-against-rainfall": {
    "tools": [
      "summary"
    ],
    "args": {
      "summary": [
        {
          "chart_readings": {
            "regex": "(?s)(?=.*:rating)(?=.*rain)",
            "e.g.": [
              "air.pm2_5:rating",
              "rainfall.rain"
            ]
          },
          "period": {
            "means": "last 30 days"
          },
          "chart": {
            "one_of": [
              true,
              null
            ]
          }
        },
        {
          "readings": {
            "regex": "(?s)(?=.*:rating)(?=.*rain)",
            "e.g.": [
              "air.pm2_5:rating",
              "rain"
            ]
          },
          "chart_readings": {
            "absent": true
          },
          "period": {
            "means": "last 30 days"
          },
          "chart": {
            "one_of": [
              true,
              null
            ]
          }
        }
      ]
    },
    "note": "the rating drawn over time is summary's chart (\":rating\"), with rain in a panel below; relate would draw PM2.5, not its rating. summary also takes the \":rating\" in `readings` (summarised, and drawn as its rating when chart_readings isn't sent), as deepseek sent it on 10 Nov 2026"
  },
  "air-quality-vs-everything": {
    "tools": [
