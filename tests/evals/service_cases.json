    ],
    "not_tools": [
      "summary",
      "readings",
      "days",
      "relate",
      "scan"
    ],
    "note": "\"metrics\" alone is what is measured (about; the bot answered it from its prompt) or the metrics now (current): a plain client with only the tool list may read it either way, and both answer it (the first live run called current {}); never a period's history"
  },
