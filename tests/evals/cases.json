[
  {
    "id": "3m-average",
    "ask": "average temp 3m",
    "note": "3m was read as 3 days",
    "expect": {
      "hints": [
        "\"3m\" = last 3 months: 2026-07-01"
      ],
      "effort": "none",
      "chart_fields": [],
      "tools": [
        "weather_history"
      ],
      "args": {
        "weather_history": {
          "start_date": {
            "regex": "^2026-07-0[1-2]"
          },
          "average": true
        }
      }
    },
    "covers": [
      "q:average",
      "m:temperature"
    ]
  },
