# ecobot-mcp, the MCP server (python -m ecobot_mcp, docs/ecobot-mcp.md step 5): the sources and their syncers, the alert rules and
# the MCP server at http://127.0.0.1:8765/mcp. Installed with ecobot.service, from the same checkout and venv (see that file), and
# enabled first: the bot is its client (BOT_MCP_URL), and its unit pulls this one in and starts after it.
#   sudo cp /opt/ecobot/ecobot-mcp.service /opt/ecobot/ecobot.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now ecobot-mcp.service ecobot.service
# Only one ecobot-mcp runs on a data folder (mcp.lock): a second stops at start, saying so.
# The data folder is the bot's own, /var/lib/private/ecobot (StateDirectory=ecobot): User=ecobot gives this unit the same dynamic user
# as ecobot.service, so the two share the folder's owner and neither takes it from the other when it starts. The token: the first of
# AUTH_TOKENS, which the bot sends and this accepts; with AUTH_TOKENS unset, the one this generates at its first start in the data
# folder (/var/lib/private/ecobot/auth_token, readable by that user only), which the bot reads from there.
# It reads /etc/ecobot.env as the bot does, less the bot's and irrigation-mcp's secrets, by their names and their old ones (UnsetEnvironment=): its
# settings are the MCP_ ones and the shared ones (docs/configuration.md). MCP_BIND defaults to 127.0.0.1:8765; to reach it from other
# machines set MCP_BIND=0.0.0.0:8765 and put TLS in front of it.
[Unit]
Description=ecobot-mcp (the ecobot MCP server: sources, alert rules)
After=network-online.target
Wants=network-online.target
Before=ecobot.service

[Service]
DynamicUser=yes
User=ecobot
Group=ecobot
WorkingDirectory=/opt/ecobot
EnvironmentFile=/etc/ecobot.env
UnsetEnvironment=BOT_TELEGRAM_TOKEN TELEGRAM_BOT_TOKEN BOT_OPENROUTER_API_KEY OPENROUTER_API_KEY IRRIGATION_TUYA_CLIENT_ID BOT_TUYA_CLIENT_ID TUYA_CLIENT_ID IRRIGATION_TUYA_CLIENT_SECRET BOT_TUYA_CLIENT_SECRET TUYA_CLIENT_SECRET WEATHER_MCP_TOKEN
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/var/cache/ecobot/pycache
StateDirectory=ecobot
CacheDirectory=ecobot
ExecStart=/opt/ecobot/.venv/bin/python -m ecobot_mcp
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecobot-mcp

# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/boot /media /mnt
UMask=0077

# Privilege restrictions
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel and system protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Process isolation
ProtectProc=invisible
RestrictNamespaces=yes

# Network: HTTPS to the weather, air, pollen and forecast APIs and Home Assistant, and its own MCP port (AF_UNIX: the local name
# resolver; AF_NETLINK: listing the network interfaces, which finding the air sensor by its .local name needs)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Resource limits
TasksMax=64
MemoryAccounting=yes
MemoryHigh=300M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
