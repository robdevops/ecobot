# The weather service on its own (python -m ecobot_service, docs/mcp-service.md step 5): the sources and their syncers, the alert rules
# and the MCP server at http://127.0.0.1:8765/mcp. Install it beside ecobot.service, from the same checkout and venv (see that file):
#   sudo cp /opt/ecobot/ecobot-mcp.service /etc/systemd/system/ && sudo systemctl daemon-reload
# Only one process runs the service on a data folder (service.lock): before enabling this, make the bot its client (WEATHER_MCP_URL
# and WEATHER_MCP_TOKEN in /etc/ecobot.env, with the token in MCP_TOKENS) and restart it; otherwise this one stops at start, saying so.
# The data folder is the bot's own, /var/lib/private/ecobot (StateDirectory=ecobot): User=ecobot gives this unit the same dynamic user
# as ecobot.service, so the two share the folder's owner and neither takes it from the other when it starts.
# It reads /etc/ecobot.env as the bot does, less the bot's own secrets (UnsetEnvironment=). MCP_BIND defaults to 127.0.0.1:8765; to
# reach it from other machines set MCP_BIND=0.0.0.0:8765 (refused without MCP_TOKENS) and put TLS in front of it.
[Unit]
Description=ecobot weather service (MCP)
After=network-online.target
Wants=network-online.target
Before=ecobot.service

[Service]
DynamicUser=yes
User=ecobot
Group=ecobot
WorkingDirectory=/opt/ecobot
EnvironmentFile=/etc/ecobot.env
UnsetEnvironment=TELEGRAM_BOT_TOKEN OPENROUTER_API_KEY WEATHER_MCP_TOKEN TUYA_CLIENT_ID TUYA_CLIENT_SECRET
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/var/cache/ecobot/pycache
StateDirectory=ecobot
CacheDirectory=ecobot
ExecStart=/opt/ecobot/.venv/bin/python -m ecobot_service
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecobot-mcp

# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/boot /media /mnt
UMask=0077

# Privilege restrictions
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel and system protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Process isolation
ProtectProc=invisible
RestrictNamespaces=yes

# Network: HTTPS to the weather, air, pollen and forecast APIs and Home Assistant, and its own MCP port (AF_UNIX: the local name
# resolver; AF_NETLINK: listing the network interfaces, which finding the air sensor by its .local name needs)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Resource limits
TasksMax=64
MemoryAccounting=yes
MemoryHigh=300M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
