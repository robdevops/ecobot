# The bot's defaults in Docker (compose.yaml reads this before /etc/ecobot.env, so a setting there wins): the bot is a client of
# the ecobot-mcp container, reached by its name on the project's network.
# (An old WEATHER_MCP_URL in /etc/ecobot.env no longer overrides this: rename it BOT_MCP_URL.)
BOT_MCP_URL=http://ecobot-mcp:8765/mcp
# irrigation-mcp (the `irrigation` profile): none by default, so no Irrigation button. With that container running, set
# BOT_IRRIGATION_MCP_URL=http://irrigation-mcp:8766/mcp in /etc/ecobot.env (a systemd install's http://127.0.0.1:8766/mcp would be the
# bot's own container here: the bot's log says so).
BOT_IRRIGATION_MCP_URL=
