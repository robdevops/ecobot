# Install as /etc/systemd/system/ecobot.service. Nothing here names the project's directory except the one
# WorkingDirectory line: %h is the home directory of the User below, so a clone at ~/ecobot needs no editing, and any other
# place needs only that line. The bot's code and data files (caches, state) are found relative to its own location.
# The .venv is built with Python 3.13.5 (.python-version): python3.13 -m venv .venv && .venv/bin/pip install -r requirements.txt
# The bot never opens the environment file itself: systemd loads it (TZ, XAI_*, ECOWITT_*, AIRGRADIENT_*, TUYA_*,
# TELEGRAM_BOT_TOKEN, ...).
# StateDirectory= gives the bot /var/lib/ecobot (the state file, the SQLite caches and Matplotlib's font cache): the bot finds it through
# STATE_DIRECTORY, so no DATA_DIR is needed, and it is the only place the sandbox below lets it write. Files kept in the clone until now
# (bot_state.json, *_cache.sqlite) are not read from there any more: move them into /var/lib/ecobot once, owned by the User below.
# ProtectHome=read-only because the code and .venv live in the User's home; installed under /opt instead, use ProtectHome=yes.
[Unit]
Description=ecobot (Telegram weather and air-quality bot)
After=network-online.target
Wants=network-online.target

[Service]
User=rob
WorkingDirectory=%h/ecobot
EnvironmentFile=/etc/ecobot.env
Environment=PYTHONUNBUFFERED=1
# One BLAS thread: numpy's thread pool gains a bot this small nothing and counts against TasksMax.
Environment=OPENBLAS_NUM_THREADS=1
StateDirectory=ecobot
ExecStart=%h/ecobot/.venv/bin/python ecobot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecobot

# Filesystem isolation
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/boot /media /mnt
UMask=0077

# Privilege restrictions
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel and system protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Process isolation
ProtectProc=invisible
RestrictNamespaces=yes

# Network: HTTPS to the weather, air, pollen, Tuya, Telegram and model APIs (AF_UNIX: the local name resolver)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
TasksMax=64
MemoryAccounting=yes
MemoryHigh=300M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
