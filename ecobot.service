# Install as /etc/systemd/system/ecobot.service, with the code outside every home directory:
#   sudo git clone <repo> /opt/ecobot && cd /opt/ecobot
#   sudo python3.13 -m venv .venv && sudo .venv/bin/pip install -r requirements.txt     # Python 3.13.5 (.python-version)
# The files stay owned by root and readable by all: the service runs as a throw-away user (DynamicUser=) that cannot write to them,
# so its bytecode goes to /var/cache/ecobot (CacheDirectory=, PYTHONPYCACHEPREFIX=) and is rebuilt on its own after an update.
# Any other place needs only the WorkingDirectory and ExecStart lines changed.
# The bot never opens the environment file itself: systemd loads it (TZ, OPENROUTER_*, ECOWITT_*, AIRGRADIENT_*, TUYA_*,
# TELEGRAM_BOT_TOKEN, ...).
# StateDirectory= gives the bot /var/lib/ecobot (the state file and the SQLite caches): the bot finds it through
# STATE_DIRECTORY, so no DATA_DIR is needed, and it is the only place the sandbox below lets it write. Files an older install kept in
# the checkout (bot_state.json, *_cache.sqlite) are not read from there: with the service stopped, copy them into /var/lib/ecobot once;
# systemd hands the folder to the dynamic user when it starts.
[Unit]
Description=ecobot (Telegram weather and air-quality bot)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/ecobot
EnvironmentFile=/etc/ecobot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/var/cache/ecobot/pycache
# One BLAS thread: numpy's thread pool gains a bot this small nothing and counts against TasksMax.
Environment=OPENBLAS_NUM_THREADS=1
StateDirectory=ecobot
CacheDirectory=ecobot
ExecStart=/opt/ecobot/.venv/bin/python ecobot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecobot

# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/boot /media /mnt
UMask=0077

# Privilege restrictions
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel and system protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Process isolation
ProtectProc=invisible
RestrictNamespaces=yes

# Network: HTTPS to the weather, air, pollen, Tuya, Telegram and model APIs (AF_UNIX: the local name resolver; AF_NETLINK: listing
# the network interfaces, which finding the air sensor by its .local name on the network needs)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Resource limits
TasksMax=64
MemoryAccounting=yes
MemoryHigh=300M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
