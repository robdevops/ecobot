# /etc/systemd/system/ecobot.service
# The bot never opens the environment file itself: systemd loads it (TZ, XAI_*, ECOWITT_*,
# AIRGRADIENT_*, TELEGRAM_BOT_TOKEN, ...).
[Unit]
Description=ecobot (Telegram weather and air-quality bot)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ecobot
EnvironmentFile=/etc/ecobot.env
ExecStart=/opt/ecobot/.venv/bin/python ecobot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
